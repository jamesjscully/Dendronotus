\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces {\bf  Validation of model resilience through targeted perturbations. Fact-check list I:} Compare the six modeling panels with their corresponding experimental originals shown in Figs.~5A–C and E–G of Ref.~\cite  {SakuraiKatz2016}. For empirical evidence of network resilience, see Fig.~5 in Ref.~\cite  {SakuraiKatz2017}; for experimental proof of post-inhibitory rebound (PIR) in the CPG interneurons, see Fig.~5 in Ref.~\cite  {sakurai2022bursting}. The figure compares specific and distinct responses of the modeled swim CPG to targeted perturbations—produced by injecting hyper-polarizing and depolarizing current pulses (indicated by red vertical arrows) into selected interneurons—with those observed experimentally (not pictured). The ability to reestablish normal rhythm following transient disturbance demonstrates the instrinsic resilience of the circuit.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:perturbation_responses}{{4}{8}{{\bf Validation of model resilience through targeted perturbations. Fact-check list I:} Compare the six modeling panels with their corresponding experimental originals shown in Figs.~5A–C and E–G of Ref.~\cite {SakuraiKatz2016}. For empirical evidence of network resilience, see Fig.~5 in Ref.~\cite {SakuraiKatz2017}; for experimental proof of post-inhibitory rebound (PIR) in the CPG interneurons, see Fig.~5 in Ref.~\cite {sakurai2022bursting}. The figure compares specific and distinct responses of the modeled swim CPG to targeted perturbations—produced by injecting hyper-polarizing and depolarizing current pulses (indicated by red vertical arrows) into selected interneurons—with those observed experimentally (not pictured). The ability to reestablish normal rhythm following transient disturbance demonstrates the instrinsic resilience of the circuit}{figure.4}{}}
\citation{SakuraiKatz2016}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces {\bf  Symmetric perturbation experiments validating the swim CPG model. Fact-check list II}: Compare the four modeling panels with their corresponding experimental originals shown in Figs.~7Ai–Di of Ref.~\cite  {SakuraiKatz2016}. The swim CPG model exhibits responses during control swims that closely match the biological data under various temporal perturbations—produced by applying hyperpolarizing or depolarizing current pulses (red vertical arrows) to targeted interneurons—thereby validating the model against its experimental counterparts. These results confirm that the modeled CPG reproduces the timing, polarity, and recovery dynamics of the living network across a range of perturbation strengths.}}{9}{figure.5}\protected@file@percent }
\newlabel{fig:group_fig7}{{5}{9}{{\bf Symmetric perturbation experiments validating the swim CPG model. Fact-check list II}: Compare the four modeling panels with their corresponding experimental originals shown in Figs.~7Ai–Di of Ref.~\cite {SakuraiKatz2016}. The swim CPG model exhibits responses during control swims that closely match the biological data under various temporal perturbations—produced by applying hyperpolarizing or depolarizing current pulses (red vertical arrows) to targeted interneurons—thereby validating the model against its experimental counterparts. These results confirm that the modeled CPG reproduces the timing, polarity, and recovery dynamics of the living network across a range of perturbation strengths}{figure.5}{}}
